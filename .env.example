# CodePilot Recall — example environment configuration.
# Copy to .env and adjust. NEVER commit real secrets.

# --- Core ---
ENVIRONMENT=local                # local | test | staging | production
LOG_LEVEL=INFO                   # DEBUG | INFO | WARNING | ERROR

# --- PostgreSQL (docker compose spins this up locally) ---
POSTGRES_USER=codepilot
POSTGRES_PASSWORD=codepilot      # change in any shared environment
POSTGRES_DB=codepilot
POSTGRES_PORT=5432

# Used by the API and Alembic. psycopg3 driver scheme: postgresql+psycopg://
DATABASE_URL=postgresql+psycopg://codepilot:codepilot@localhost:5432/codepilot

# --- Redis (broker/result backend for Celery) ---
REDIS_URL=redis://localhost:6379/0

# --- API ---
CORS_ORIGINS=http://localhost:3000   # comma-separated list

# --- Codeforces (Phase 1; public API, no credentials required) ---
CF_API_BASE_URL=https://codeforces.com/api
# Keep >= 2s: Codeforces documents ~1 request / 2 seconds as the polite bound.
CF_REQUEST_INTERVAL_SECONDS=2.5
CF_SYNC_INTERVAL_MINUTES=30
CF_STATUS_PAGE_SIZE=1000
CF_MAX_RETRIES=5
CF_BACKOFF_BASE_SECONDS=1.0
CF_BACKOFF_MAX_SECONDS=60.0
CF_CONNECT_TIMEOUT_SECONDS=5.0
CF_READ_TIMEOUT_SECONDS=30.0
CF_HISTORICAL_MAX_PAGES=200
CF_INCREMENTAL_MAX_PAGES=20

# --- Authentication & sessions (Phase 5) ---
# Argon2id parameters (defaults benchmarked ~120ms; tune deliberately).
ARGON2_TIME_COST=2
ARGON2_MEMORY_COST=65536
ARGON2_PARALLELISM=4
# Session lifetimes: absolute 30 days, inactivity 7 days.
SESSION_ABSOLUTE_SECONDS=2592000
SESSION_INACTIVITY_SECONDS=604800
# Shared rate limits ("events:window_seconds").
RATE_LIMIT_REGISTER=5:3600
RATE_LIMIT_LOGIN_IP=10:900
RATE_LIMIT_LOGIN_EMAIL=10:900
# Fail closed (503) for auth endpoints when Redis is down in production.
RATE_LIMIT_FAIL_CLOSED=true
# Per-user quota for linked Codeforces handles.
MAX_LINKED_ACCOUNTS=5

# --- Beta gate (Phase 6) ---
# When NON-EMPTY, only these addresses may register (server-enforced).
# Empty = open registration. Comma-separated.
BETA_ALLOWED_EMAILS=

# --- Frontend (apps/web) ---
# Leave EMPTY in deployment: the browser uses same-origin /api/v1 paths
# served by the Next.js proxy, which forwards to API_SERVER_URL.
NEXT_PUBLIC_API_BASE_URL=
# Server-side proxy target (Next.js route handlers only; never exposed to
# the browser). Default locally: http://127.0.0.1:8000
API_SERVER_URL=http://127.0.0.1:8000

# --- Deployment (Phase 6, provider dashboards — never commit real values) ---
# Neon: paste the POOLED url (runtime) and DIRECT url (migrations) AS-IS.
# The app normalizes postgresql:// -> postgresql+psycopg:// and adds
# sslmode=require for *.neon.tech hosts automatically (existing query
# parameters are preserved; sslmode is never duplicated). Upstash: use the
# RESP endpoint (rediss://) — TLS is configured by the app.

# Proxy cold-start tuning (Phase 6; defaults below — usually untouched):
# PROXY_TIMEOUT_MS=20000          # per-attempt upstream timeout
# WAKE_RETRY_WINDOW_MS=90000      # total budget for waking a sleeping API
# PROXY_RETRY_DELAY_MS=2000       # delay between wake retries
