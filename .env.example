# CodePilot Recall — example environment configuration.
# Copy to .env and adjust. NEVER commit real secrets.

# --- Core ---
ENVIRONMENT=local                # local | test | staging | production
LOG_LEVEL=INFO                   # DEBUG | INFO | WARNING | ERROR

# --- PostgreSQL (docker compose spins this up locally) ---
POSTGRES_USER=codepilot
POSTGRES_PASSWORD=codepilot      # change in any shared environment
POSTGRES_DB=codepilot
POSTGRES_PORT=5432

# Used by the API and Alembic. psycopg3 driver scheme: postgresql+psycopg://
DATABASE_URL=postgresql+psycopg://codepilot:codepilot@localhost:5432/codepilot

# --- Redis (broker/result backend for Celery) ---
REDIS_URL=redis://localhost:6379/0

# --- API ---
CORS_ORIGINS=http://localhost:3000   # comma-separated list

# --- Codeforces (Phase 1; public API, no credentials required) ---
CF_API_BASE_URL=https://codeforces.com/api
# Keep >= 2s: Codeforces documents ~1 request / 2 seconds as the polite bound.
CF_REQUEST_INTERVAL_SECONDS=2.5
CF_SYNC_INTERVAL_MINUTES=30
CF_STATUS_PAGE_SIZE=1000
CF_MAX_RETRIES=5
CF_BACKOFF_BASE_SECONDS=1.0
CF_BACKOFF_MAX_SECONDS=60.0
CF_CONNECT_TIMEOUT_SECONDS=5.0
CF_READ_TIMEOUT_SECONDS=30.0
CF_HISTORICAL_MAX_PAGES=200
CF_INCREMENTAL_MAX_PAGES=20

# --- Frontend (apps/web) ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
